# Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=""

# Gemini Model Selection (e.g. gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Supabase Credentials (Find in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key"

# Optional: Service Role Key (for administrative access bypassing RLS if needed)
SUPABASE_SERVICE_ROLE_KEY=""
