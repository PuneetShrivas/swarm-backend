# ==============================================================================
# Standalone Agnostic Research & Report Generation Swarm - Environment Configuration
# ==============================================================================

# 1. Perplexity Search API (Required for web search retrieval)
PERPLEXITY_API_KEY="pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PERPLEXITY_BASE_URL="https://api.perplexity.ai"
PERPLEXITY_SEARCH_TYPE="fast"

# 2. Azure AI Foundry / Azure OpenAI (Claude / GPT models)
AZURE_FOUNDRY_ENDPOINT="https://puneetshrivas32-0871-resource.services.ai.azure.com"
AZURE_API_KEY=""

# 3. Groq Cloud (Llama / Mixtral models)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# 4. Google Gemini API (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=""

# 5. IteraCompute (OpenAI-compatible)
ITERACT_API_KEY=""
ITERACT_BASE_URL="https://api.iteract.ai/v1"

# 6. Storage & Cache directories (Optional - defaults to local ./artifacts and ./.cache_agnostic_retrieval)
ARTIFACTS_DIR="./artifacts"
CACHE_DIR="./.cache_agnostic_retrieval"
